<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/todayFragment">

    <fragment
        android:id="@+id/todayFragment"
        android:name="ir.pooyadev.presentation.view.fragment.TodayFragment"
        android:label="fragment_today"
        tools:layout="@layout/fragment_today" >
        <action
            android:id="@+id/action_todayFragment_to_addEditFoodLogBottomSheetFragment"
            app:destination="@id/addEditFoodLogBottomSheetFragment" />
    </fragment>
    <dialog
        android:id="@+id/addEditFoodLogBottomSheetFragment"
        android:name="ir.pooyadev.presentation.view.fragment.AddEditFoodLogBottomSheetFragment"
        android:label="AddEditFoodLogBottomSheetFragment"
        tools:layout="@layout/layout_dialog_food_log">
        <argument
            android:name="isEditFoodLog"
            app:argType="boolean" />
        <argument
            android:name="foodLogForEdit"
            app:argType="ir.pooyadev.domain.model.local.FoodLog"
            app:nullable="true"
            />
    </dialog>
</navigation>